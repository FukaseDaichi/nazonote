# Copy this file to state/.env and replace the placeholder values.
# state/.env is ignored by git and is read by scripts/run.sh and scripts/line_notify.py.

# Claude Code headless token. Existing state/.claude_token still works as a fallback,
# but using this env file keeps external settings in one place.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-replace-me

# Set to 0 to disable LINE notification without changing code.
MOBILE_NOTIFY_ENABLED=1

# LINE Messaging API settings.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_TO_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL sent to LINE. {date} is replaced with YYYY-MM-DD.
GITHUB_DAILY_URL_TEMPLATE=https://github.com/FukaseDaichi/nazonote/blob/main/daily/{date}-osusume.md
